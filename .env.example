# ---------------------------------------------------------------------------
# Docker Compose settings. Copy to `.env` to override any of these; every value
# below is already the built-in default, so the stack runs with no .env at all.
# ---------------------------------------------------------------------------

# --- Ports on your machine -------------------------------------------------
CLIENT_PORT=8080
CATALOG_API_PORT=5080
ORDERS_API_PORT=3000
MSSQL_PORT=1433
ELASTICSEARCH_PORT=9200
MONGODB_PORT=27017

# --- SQL Server ------------------------------------------------------------
# Must satisfy SQL Server's password policy: 8+ chars with upper, lower and digit.
MSSQL_SA_PASSWORD=Your_strong_Passw0rd

# --- Orders persistence ----------------------------------------------------
# "elasticsearch" (the assignment's preferred store) or "mongodb".
# This single variable swaps the entire persistence layer of the orders service.
NOSQL_DRIVER=elasticsearch
ELASTICSEARCH_INDEX=orders
MONGODB_DATABASE=orders
MONGODB_COLLECTION=orders

# --- Client ----------------------------------------------------------------
# Initial UI language before the user picks one: he | en
VITE_DEFAULT_LOCALE=he

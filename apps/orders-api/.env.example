# ---------------------------------------------------------------------------
# orders-api — see docs/CONTRACT.md §4 for the authoritative list.
# Copy to .env for local development; every value below is also the default.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Which NoSQL store to persist orders to: "elasticsearch" | "mongodb".
# This is the only change required to swap the whole persistence layer.
NOSQL_DRIVER=elasticsearch

# --- Elasticsearch driver --------------------------------------------------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=orders
# Optional basic auth; leave empty for a local single-node cluster with security off.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- MongoDB driver --------------------------------------------------------
MONGODB_URI=mongodb://localhost:27018
MONGODB_DATABASE=orders
MONGODB_COLLECTION=orders
MONGODB_MAX_POOL_SIZE=10

# --- HTTP ------------------------------------------------------------------
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Optional: absolute path to orders.mapping.json. Only needed when the
# infra/ folder is mounted somewhere non-standard; otherwise the file is found
# by walking up from the compiled sources, with an embedded copy as fallback.
# ORDERS_MAPPING_PATH=/app/infra/elasticsearch/orders.mapping.json
